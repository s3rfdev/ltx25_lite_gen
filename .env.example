# ── Hugging Face ──────────────────────────────────────────────────────────
# REQUIRED on any GPU node: Lightricks repos are gated, your token's user
# must have accepted the LTX-2.5 license at https://huggingface.co/Lightricks/LTX-2.5
HF_TOKEN=

# HF Space (frontend-only) that ctl.py hf push syncs to
HF_SPACE_ID=s3rfdev/ltx25_lite_gen

# ── SaladCloud ────────────────────────────────────────────────────────────
SALAD_API_KEY=
SALAD_ORGANIZATION_NAME=
SALAD_PROJECT_NAME=default
SALAD_CONTAINER_NAME=ltx25-lite-gen

# ── Docker image used by salad up / local up ──────────────────────────────
DOCKER_IMAGE=s3rfdev/ltx25-lite-gen:latest

# ── Vast.ai ───────────────────────────────────────────────────────────────
VAST_API_KEY=
